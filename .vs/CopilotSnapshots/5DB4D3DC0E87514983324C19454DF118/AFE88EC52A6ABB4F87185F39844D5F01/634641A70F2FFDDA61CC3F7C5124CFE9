using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;

namespace Biblio_classe
{
    /// <summary>
    /// Entité représentant un utilisateur de l'application Todo
    /// Cette classe correspond à la table Users en base de données
    /// </summary>
    public class User
    {
        /// <summary>
        /// Identifiant unique de l'utilisateur (clé primaire)
        /// Généré automatiquement par la base de données
        /// </summary>
        [Key]
        public int Id { get; set; }

        /// <summary>
        /// Nom de famille de l'utilisateur
        /// Champ obligatoire, limité à 80 caractères
        /// </summary>
        [Required]
        [MaxLength(80)]
        public string Nom { get; set; } = string.Empty;

        /// <summary>
        /// Prénom de l'utilisateur
        /// Champ obligatoire, limité à 80 caractères
        /// </summary>
        [Required]
        [MaxLength(80)]
        public string Prenom { get; set; } = string.Empty;

        /// <summary>
        /// Adresse email de l'utilisateur
        /// Champ obligatoire, limité à 100 caractères, doit être unique
        /// </summary>
        [Required]
        [MaxLength(100)]
        public string Email { get; set; } = string.Empty;

        /// <summary>
        /// Mot de passe de l'utilisateur (devrait être hashé en production)
        /// Champ obligatoire, limité à 40 caractères
        /// </summary>
        [Required]
        [MaxLength(40)]
        public string MotDePasse { get; set; } = string.Empty;

        /// <summary>
        /// Collection des tâches assignées à cet utilisateur
        /// Propriété de navigation vers l'entité Task
        /// Permet d'accéder facilement aux tâches d'un utilisateur
        /// </summary>
        public virtual ICollection<Task> Tasks { get; set; } = new List<Task>();
    }
}
